{% comment %}
  sections/purelane-combos.liquid
  Best Selling Combos rail section matching prototype #combos section.
{% endcomment %}

<section
  class="sec purelane-wrapper"
  id="combos-{{ section.id }}"
  data-scene="3"
  data-purelane-section-type="purelane-combos"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="rule">
        <i></i>
        {% render 'purelane-icons', icon: 'leaf' %}
        <i></i>
      </div>

      {%- if section.settings.description != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign combo_blocks = section.blocks | where: 'type', 'combo_card' -%}
    <div class="comborail rv">
      {%- if combo_blocks.size > 0 -%}
        {%- for block in combo_blocks limit: 10 -%}
          {%- assign combo_products = block.settings.products -%}
          {%- assign combo_compare_sum = 0 -%}
          {%- assign combo_selling_sum = 0 -%}
          {%- assign product_count = 0 -%}

          {%- for prod in combo_products -%}
            {%- assign variant = prod.selected_or_first_available_variant -%}
            {%- if variant != blank -%}
              {%- assign v_price = variant.price -%}
              {%- assign v_compare = variant.compare_at_price -%}
              {%- if v_compare == blank or v_compare <= 0 -%}
                {%- assign v_compare = v_price -%}
              {%- endif -%}

              {%- assign combo_selling_sum = combo_selling_sum | plus: v_price -%}
              {%- assign combo_compare_sum = combo_compare_sum | plus: v_compare -%}
              {%- assign product_count = product_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if block.settings.override_price != blank and block.settings.override_price > 0 -%}
            {%- assign combo_price = block.settings.override_price | times: 100 -%}
          {%- else -%}
            {%- assign combo_price = combo_selling_sum -%}
          {%- endif -%}

          {%- assign combo_compare_price = combo_compare_sum -%}
          {%- assign combo_savings = combo_compare_price | minus: combo_price -%}

          <article
            class="glass combo {% if block.settings.is_hero_combo %}hero-combo{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="tray">
              {%- if combo_savings > 0 -%}
                <span class="save">You save {{ combo_savings | money_without_trailing_zeros }}</span>
              {%- endif -%}

              {%- if block.settings.badge_flag != blank -%}
                <span class="flag">{{ block.settings.badge_flag | escape }}</span>
              {%- endif -%}

              <div class="stack">
                {%- if combo_products.size > 0 -%}
                  {%- for prod in combo_products limit: 5 -%}
                    <span class="it">
                      {% render 'purelane-product-image', image: prod.featured_image, alt: prod.title, class: 'pimg' %}
                      <span>{{ prod.title | truncate: 24 | escape }}</span>
                    </span>
                    {%- unless forloop.last -%}
                      <span class="plus" aria-hidden="true">+</span>
                    {%- endunless -%}
                  {%- endfor -%}
                {%- else -%}
                  <!-- Theme Editor empty state placeholder -->
                  <span class="it">
                    <span class="tile">
                      {% render 'purelane-icons', icon: 'leaf' %}
                    </span>
                    <span>Select products</span>
                  </span>
                {%- endif -%}
              </div>
            </div>

            <div class="body">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- else -%}
                <h3>Combo Box</h3>
              {%- endif -%}

              <div class="cnt">{{ product_count }} product{% if product_count != 1 %}s{% endif %}</div>

              {%- if block.settings.includes_summary != blank -%}
                <p class="inc">{{ block.settings.includes_summary | escape }}</p>
              {%- endif -%}

              <div class="prow">
                <strong>{{ combo_price | money_without_trailing_zeros }}</strong>
                {%- if combo_compare_price > combo_price -%}
                  <s>{{ combo_compare_price | money_without_trailing_zeros }}</s>
                {%- endif -%}

                {%- if combo_savings > 0 -%}
                  <em>Save {{ combo_savings | money_without_trailing_zeros }}</em>
                {%- endif -%}
              </div>

              <div class="fine">Inclusive of all taxes &middot; COD available</div>

              {%- assign cta_label = block.settings.cta_text | default: 'Shop bundle' -%}
              {%- assign cta_href = block.settings.cta_url | default: '#bundles' -%}

              <a
                class="btn {% if block.settings.is_hero_combo %}btn-primary{% else %}btn-ghost{% endif %}"
                href="{{ cta_href }}"
              >
                {{ cta_label | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Theme Editor placeholder if no combo blocks configured -->
        <article class="glass combo hero-combo">
          <div class="tray">
            <span class="save">You save &#8377;398</span>
            <span class="flag">Best value</span>
            <div class="stack">
              <span class="it">
                {% render 'purelane-product-image', image: nil, alt: 'Kitchen Cleaner' %}
                <span>Kitchen cleaner</span>
              </span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it">
                {% render 'purelane-product-image', image: nil, alt: 'Dishwash' %}
                <span>Dishwash gel</span>
              </span>
              <span class="plus" aria-hidden="true">+</span>
              <span class="it">
                {% render 'purelane-product-image', image: nil, alt: 'Tap cleaner' %}
                <span>Tap cleaner</span>
              </span>
            </div>
          </div>
          <div class="body">
            <h3>Kitchen essentials</h3>
            <div class="cnt">3 products</div>
            <p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner.</p>
            <div class="prow">
              <strong>&#8377;499</strong>
              <s>&#8377;897</s>
              <em>Save &#8377;398</em>
            </div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn btn-primary" href="#bundles">
              Shop bundle
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      {%- endif -%}
    </div>

    {%- if section.settings.swipe_cue_text != blank -%}
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        {{ section.settings.swipe_cue_text | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.rail_note != blank -%}
      <p class="railnote">{{ section.settings.rail_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos Rail",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "swipe_cue_text",
      "label": "Swipe Cue Text",
      "default": "Swipe for more combos"
    },
    {
      "type": "text",
      "id": "rail_note",
      "label": "Rail Note",
      "default": "Select your preferred combo box to view included products and proceed to checkout."
    }
  ],
  "blocks": [
    {
      "type": "combo_card",
      "name": "Combo Card",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "badge_flag",
          "label": "Badge Flag",
          "default": "Most popular"
        },
        {
          "type": "checkbox",
          "id": "is_hero_combo",
          "label": "Highlight Card (Featured Hero Combo)",
          "default": false
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Select Products in Combo",
          "limit": 5
        },
        {
          "type": "number",
          "id": "override_price",
          "label": "Bundle Price Override (in ₹)",
          "info": "Leave blank to sum individual product prices"
        },
        {
          "type": "textarea",
          "id": "includes_summary",
          "label": "Includes Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos Rail",
      "blocks": [
        {
          "type": "combo_card",
          "settings": {
            "title": "Kitchen essentials",
            "badge_flag": "Most popular",
            "is_hero_combo": false,
            "override_price": 499
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Laundry care bundle",
            "is_hero_combo": false,
            "override_price": 499
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Complete home bundle",
            "badge_flag": "Best value",
            "is_hero_combo": true,
            "override_price": 799
          }
        }
      ]
    }
  ]
}
{% endschema %}
