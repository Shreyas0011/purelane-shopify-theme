{% comment %}
  sections/purelane-shop.liquid
  Purelane Shop Grid section matching prototype #shop section.
{% endcomment %}

<section
  class="sec purelane-wrapper"
  id="shop-{{ section.id }}"
  data-scene="3"
  data-purelane-section-type="purelane-shop"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="rule">
        <i></i>
        {% render 'purelane-icons', icon: 'leaf' %}
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign selected_collection = section.settings.collection -%}
      {%- assign products_limit = section.settings.products_to_show | default: 4 -%}

      {%- if selected_collection != blank and selected_collection.products.size > 0 -%}
        {%- for product in selected_collection.products limit: products_limit -%}
          {% render 'purelane-product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% comment %} Fallback rendering when no collection selected in theme editor {% endcomment %}
        {%- for i in (1..products_limit) -%}
          <article class="glass card purelane-card rv">
            <div class="shot purelane-card-shot">
              <span class="pill purelane-card-pill">Bestseller</span>
              {% render 'purelane-product-image', image: nil, alt: 'Sample Product' %}
            </div>
            <div class="purelane-card-body">
              <h3 class="purelane-card-title">
                <a href="#shop">Sample Purelane Cleaner {{ i }}</a>
              </h3>
              <div class="purelane-card-footer">
                <div class="pr purelane-card-pr">
                  <strong>&#8377;200</strong>
                  <s>&#8377;299</s>
                  <em>33% off</em>
                </div>
                <button type="button" class="btn btn-ghost btn-sm purelane-card-btn">
                  Add to cart
                </button>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
