{% comment %}
  sections/purelane-bundles.liquid
  Tiered Bundle Box Builder section matching prototype #bundles section.
{% endcomment %}

<section
  class="sec purelane-wrapper"
  id="bundles-{{ section.id }}"
  data-scene="3"
  data-purelane-section-type="purelane-bundles"
>
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="lede" style="margin:0 auto">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- assign tier_blocks = section.blocks | where: 'type', 'bundle_tier' -%}
    <div class="tiers">
      {%- if tier_blocks.size > 0 -%}
        {%- for block in tier_blocks limit: 6 -%}
          {%- assign preview_prods = block.settings.preview_products -%}
          {%- if preview_prods.size > 0 -%}
            {%- assign count_val = preview_prods.size -%}
          {%- else -%}
            {%- assign count_val = block.settings.product_count | default: 2 -%}
          {%- endif -%}

          {%- assign price_val = block.settings.price | default: 0 | times: 100 -%}
          {%- assign compare_val = block.settings.compare_at_price | default: 0 | times: 100 -%}

          <article
            class="glass tier rv {% if block.settings.is_featured %}best{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag_text != blank -%}
              <span class="tag">{{ block.settings.tag_text | escape }}</span>
            {%- endif -%}

            <div class="tierpix {% if preview_prods.size >= 5 %}five{% endif %}" aria-hidden="true">
              {%- if preview_prods.size > 0 -%}
                {%- for prod in preview_prods limit: 5 -%}
                  {% render 'purelane-product-image', image: prod.featured_image, alt: prod.title, class: 'pimg' %}
                {%- endfor -%}
              {%- else -%}
                {% render 'purelane-product-image', image: nil, alt: 'Bundle tier product preview' %}
              {%- endif -%}
            </div>

            <div class="qty">
              {{ count_val }}
              <small>Products</small>
            </div>

            <div class="price">
              {{ price_val | money_without_trailing_zeros }}
              {%- if compare_val > price_val -%}
                <s>{{ compare_val | money_without_trailing_zeros }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.unit_price_note != blank -%}
              <p class="body-s" style="font-size:12px">{{ block.settings.unit_price_note | escape }}</p>
            {%- endif -%}

            {%- assign feature_lines = block.settings.feature_list | newline_to_br | split: '<br />' -%}
            {%- if feature_lines.size > 0 -%}
              <ul>
                {%- for line in feature_lines -%}
                  {%- assign clean_line = line | strip -%}
                  {%- if clean_line != blank -%}
                    <li>
                      {% render 'purelane-icons', icon: 'check' %}
                      <span>{{ clean_line | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- assign cta_label = block.settings.cta_text | default: 'Build this box' -%}
            {%- assign cta_href = block.settings.cta_url | default: '#shop' -%}

            <a
              class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}"
              href="{{ cta_href }}"
            >
              {{ cta_label | escape }}
              {%- if block.settings.is_featured -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Theme Editor placeholder if no bundle blocks configured -->
        <article class="glass tier rv">
          <span class="tag">Starter</span>
          <div class="tierpix" aria-hidden="true">
            {% render 'purelane-product-image', image: nil, alt: 'Starter Bundle' %}
          </div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">&#8377;349 <s>&#8377;598</s></div>
          <p class="body-s" style="font-size:12px">Flat &#8377;174 per product</p>
          <ul>
            <li>{% render 'purelane-icons', icon: 'check' %}Pick any two products</li>
            <li>{% render 'purelane-icons', icon: 'check' %}Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>

        <article class="glass tier best rv">
          <span class="tag">Most popular</span>
          <div class="tierpix" aria-hidden="true">
            {% render 'purelane-product-image', image: nil, alt: 'Popular Bundle' %}
          </div>
          <div class="qty">3<small>Products</small></div>
          <div class="price">&#8377;499 <s>&#8377;897</s></div>
          <p class="body-s" style="font-size:12px">Flat &#8377;166 per product</p>
          <ul>
            <li>{% render 'purelane-icons', icon: 'check' %}Pick any three products</li>
            <li>{% render 'purelane-icons', icon: 'check' %}Covers kitchen and laundry</li>
            <li>{% render 'purelane-icons', icon: 'check' %}Free shipping across India</li>
          </ul>
          <a class="btn btn-primary" href="#shop">
            Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </article>

        <article class="glass tier rv">
          <span class="tag">Whole home</span>
          <div class="tierpix five" aria-hidden="true">
            {% render 'purelane-product-image', image: nil, alt: 'Whole Home Bundle' %}
          </div>
          <div class="qty">5<small>Products</small></div>
          <div class="price">&#8377;799 <s>&#8377;1495</s></div>
          <p class="body-s" style="font-size:12px">Flat &#8377;160 per product</p>
          <ul>
            <li>{% render 'purelane-icons', icon: 'check' %}Pick any five products</li>
            <li>{% render 'purelane-icons', icon: 'check' %}Every room in one order</li>
            <li>{% render 'purelane-icons', icon: 'check' %}Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Tiered Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle_tier",
      "name": "Bundle Tier",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tier Tag",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Number of Products",
          "default": 2
        },
        {
          "type": "number",
          "id": "price",
          "label": "Tier Price (₹)",
          "default": 349
        },
        {
          "type": "number",
          "id": "compare_at_price",
          "label": "Compare Price (₹)",
          "default": 598
        },
        {
          "type": "text",
          "id": "unit_price_note",
          "label": "Unit Price Note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "feature_list",
          "label": "Features (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "product_list",
          "id": "preview_products",
          "label": "Preview Products",
          "limit": 5
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Highlight Tier (Best Value)",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Tiered Bundles",
      "blocks": [
        {
          "type": "bundle_tier",
          "settings": {
            "tag_text": "Starter",
            "product_count": 2,
            "price": 349,
            "compare_at_price": 598,
            "unit_price_note": "Flat ₹174 per product",
            "feature_list": "Pick any two products\nFree shipping across India",
            "is_featured": false
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "tag_text": "Most popular",
            "product_count": 3,
            "price": 499,
            "compare_at_price": 897,
            "unit_price_note": "Flat ₹166 per product",
            "feature_list": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "is_featured": true
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "tag_text": "Whole home",
            "product_count": 5,
            "price": 799,
            "compare_at_price": 1495,
            "unit_price_note": "Flat ₹160 per product",
            "feature_list": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "is_featured": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
