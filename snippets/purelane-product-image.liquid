{% comment %}
  snippets/purelane-product-image.liquid
  Reusable responsive Shopify product image renderer with fallback SVG vector image support.
  Accepts:
    - image: Shopify image object (or featured_image)
    - alt: Custom alt text override
    - widths: srcset widths (default: '180, 360, 540, 720')
    - sizes: sizes attribute (default: '(min-width: 860px) 25vw, 50vw')
    - loading: 'lazy' or 'eager' (default: 'lazy')
    - class: additional CSS classes
{% endcomment %}

{%- assign image_loading = loading | default: 'lazy' -%}
{%- assign image_widths = widths | default: '180, 360, 540, 720' -%}
{%- assign image_sizes = sizes | default: '(min-width: 860px) 25vw, 50vw' -%}
{%- assign image_class = class | default: 'pimg' -%}
{%- assign image_alt = alt | default: image.alt | default: 'Purelane plant-based product' | escape -%}

{%- if image != blank -%}
  {{
    image
    | image_url: width: 720
    | image_tag:
      loading: image_loading,
      widths: image_widths,
      sizes: image_sizes,
      class: image_class,
      alt: image_alt
  }}
{%- else -%}
  <div class="purelane-image-fallback" role="img" aria-label="{{ image_alt }}">
    <svg viewBox="0 0 130 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="gPureFallbackB" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".10"/>
          <stop offset=".18" stop-color="#ffffff" stop-opacity=".38"/>
          <stop offset=".5" stop-color="#dff3e4" stop-opacity=".10"/>
          <stop offset=".82" stop-color="#ffffff" stop-opacity=".22"/>
          <stop offset="1" stop-color="#9fc7b4" stop-opacity=".32"/>
        </linearGradient>
        <linearGradient id="gPureFallbackL" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#04756e"/>
          <stop offset=".55" stop-color="#4b3a8f"/>
          <stop offset="1" stop-color="#013f3d"/>
        </linearGradient>
        <linearGradient id="gPureFallbackC" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#8fa89b"/>
          <stop offset=".22" stop-color="#eef6ef"/>
          <stop offset="1" stop-color="#7d938c"/>
        </linearGradient>
      </defs>
      <ellipse cx="65" cy="190" rx="40" ry="7" fill="#01201c" opacity=".5"/>
      <path d="M40 60V48c0-7 5-12 12-12h13c8 0 13 6 13 13v11Z" fill="url(#gPureFallbackC)"/>
      <path d="M65 37c11-1 19 3 25 10 3 4 2 9-2 10l-20 3Z" fill="#cfdcd2"/>
      <path d="M14 44h27v9H19c-4 0-6-2-6-4s1-5 1-5Z" fill="#cfdcd2"/>
      <path d="M44 52c-7 3-11 9-10 16 1 6 5 10 12 10v-6c-4 0-6-2-6-5s2-6 5-7Z" fill="#cfdcd2"/>
      <rect x="38" y="56" width="42" height="7" rx="3" fill="#a8bdb2"/>
      <rect x="41" y="62" width="36" height="16" rx="4" fill="url(#gPureFallbackC)"/>
      <path d="M28 96c0-11 6-18 15-24v-8h33v8c9 6 15 13 15 24v62c0 12-8 20-21 20H49c-13 0-21-8-21-20Z" fill="url(#gPureFallbackB)" stroke="rgba(255,255,255,.4)" stroke-width="1.4"/>
      <rect x="31" y="112" width="66" height="60" rx="6" fill="url(#gPureFallbackL)"/>
      <rect x="31" y="112" width="66" height="60" rx="6" fill="none" stroke="rgba(236,230,247,.26)" stroke-width="1"/>
      <g transform="translate(58 120) scale(.5)" fill="none" stroke="#f0a03c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
      </g>
      <text x="64" y="140" text-anchor="middle" font-family="Outfit, sans-serif" font-size="8.6" font-weight="800" letter-spacing=".7" fill="#faf7fd">PURELANE</text>
      <line x1="42" y1="146" x2="86" y2="146" stroke="#f0a03c" stroke-width=".9" opacity=".85"/>
      <text x="64" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="6.4" font-weight="700" letter-spacing="1.1" fill="#ece6f7">PLANT CARE</text>
    </svg>
  </div>
{%- endif -%}
